# --- Chain ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Kunci wallet agent (lokal: pakai account #0 hardhat; JANGAN pernah commit kunci asli)
AGENT_PRIVATE_KEY=
# Kosongkan untuk auto-baca dari ../contracts/deployments/localhost.json (chain 31337)
ESCROW_ADDRESS=
TOKEN_ADDRESS=

# --- Brain (Claude) ---
ANTHROPIC_API_KEY=
# Default paling pintar. Opsi hemat hackathon: claude-sonnet-5 (intro pricing s/d Agu 2026)
ANTHROPIC_MODEL=claude-opus-4-8
# Verifikasi foto boleh pakai model berbeda (lebih murah) dari planning
VERIFIER_MODEL=
# 1 = brain palsu deterministik untuk uji loop tanpa API key (JANGAN untuk demo)
MANDOR_MOCK_BRAIN=0

# --- Verifikasi (anti-cheat) ---
# APPROVE butuh confidence model >= ambang ini
CONFIDENCE_THRESHOLD=0.8
# Batas percobaan verifikasi per task (anti spam resubmission)
MAX_VERIFICATIONS_PER_TASK=5

# --- Task ---
TASK_DEADLINE_MINUTES=60
# Folder tempat worker-app menyimpan file bukti (nama file = proofHash tanpa 0x)
PROOF_DIR=../worker-app/uploads
