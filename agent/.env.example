# --- Chain ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Kunci wallet AI arbiter (lokal: pakai account #1 hardhat — lihat contracts/scripts/deploy.js).
# JANGAN pernah commit kunci asli.
AI_ARBITER_PRIVATE_KEY=
# Kosongkan untuk auto-baca dari ../contracts/deployments/localhost.json (chain 31337)
ESCROW_ADDRESS=
TOKEN_ADDRESS=

# --- Data (dibagi dengan web/, lihat docs/rekber-ai/PLAN.md §3.3) ---
DATA_DIR=../data

# --- AI (cek pengiriman + hakim sengketa) ---
# anthropic | openai | aimlapi | mock. mock = deterministik, jelas berlabel [MOCK], JANGAN untuk demo.
AI_PROVIDER=mock
# Kosongkan untuk default per-provider (anthropic: claude-opus-4-8, openai/aimlapi: gpt-4o)
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# AI/ML API (https://aimlapi.com) — proxy OpenAI-compatible ke banyak vendor
AIMLAPI_API_KEY=
AIMLAPI_MODEL=gpt-4o
# REFUND/RELEASE butuh confidence model >= ambang ini; di bawahnya -> ESCALATE ke manusia
CONFIDENCE_THRESHOLD=0.85

# --- Loop ---
# Tunggu tanggapan penjual maksimal sekian detik sebelum hakim memutus tanpa tanggapan
SELLER_RESPONSE_SECONDS=60
POLL_MS=3000

# --- Skrip arbiter manusia (agent/scripts/human-resolve.ts saja, bukan daemon) ---
HUMAN_ARBITER_PRIVATE_KEY=
