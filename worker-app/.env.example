# --- Chain ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Kunci relayer yang sama dengan constructor TaskEscrow (address relayer_).
# Relayer membayar gas untuk claimFor/submitProofFor — worker sendiri tidak perlu ETH.
RELAYER_PRIVATE_KEY=
# Kosongkan untuk auto-baca dari ../contracts/deployments/localhost.json (chain 31337)
ESCROW_ADDRESS=
TOKEN_ADDRESS=

# --- Data task (v0: file lokal ditulis oleh agent, lihat agent/src/loop.ts) ---
MISSIONS_FILE=../agent/missions/current.json
UPLOADS_DIR=./uploads

# --- UX ---
# Base URL explorer untuk link transaksi. BSC Testnet: https://testnet.bscscan.com
# Kosongkan di localhost (link disembunyikan).
NEXT_PUBLIC_EXPLORER_URL=
# Batas ukuran upload foto bukti (MB)
MAX_UPLOAD_MB=8
# URL yang di-encode ke QR layar panggung (/panggung). Kosong = auto-detect IP LAN.
NEXT_PUBLIC_WORKER_URL=
