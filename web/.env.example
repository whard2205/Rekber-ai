# --- Chain ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Relayer membayar gas untuk fundWithSig/act (tanda tangan pengguna). Kunci hardhat #2
# lokal (lihat contracts/deployments/localhost.json). Tiga kunci terpisah dari agent —
# jangan berbagi kunci (bentrok nonce, pelajaran MANDOR O-03).
RELAYER_PRIVATE_KEY=
ESCROW_ADDRESS=
TOKEN_ADDRESS=
# Dipakai bersama agent/ — web menulis deals/evidence, agent menulis verdicts/audit-log.
DATA_DIR=../data

# --- AI (ekstraksi checklist saat penjual membuat transaksi, §3.4a) ---
AI_PROVIDER=aimlapi|openai|mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o

# --- Publik (client) ---
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
# Base URL explorer untuk link transaksi. BSC Testnet: https://testnet.bscscan.com
# Kosongkan di localhost (link disembunyikan).
NEXT_PUBLIC_EXPLORER_URL=
# URL share/QR halaman deal. Kosong = deteksi IP LAN (di /panggung).
NEXT_PUBLIC_APP_URL=

# --- Batas & fitur ---
MAX_UPLOAD_MB=6
FAUCET_ENABLED=1
# Sinkron dengan SELLER_RESPONSE_SECONDS agent/.env — countdown tanggapan penjual di UI.
SELLER_RESPONSE_SECONDS=60

# Opsional: Upstash Redis (deploy Vercel). Kosong = simpan di file data/ (development).
# Web dan agent harus memakai database yang SAMA.
KV_REST_API_URL=
KV_REST_API_TOKEN=
